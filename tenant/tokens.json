{
  "$schema": "../../hirobius.tenant-tokens.schema.json",
  "$description": "Concrete Creations brand overlay. Warm stone / brown accent palette overrides the HDS default brand-blue. Final brand hexes (Adrian, 2026-09-26): #8B6F47 rest, #75593A hover/text, #5C432A pressed, #F5EFE7 subtle. The structure (which paths get overridden) is the deliverable; the values below are final, not derived from the generic HDS stone scale.",
  "semantic": {
    "accent": {
      "$type": "color",
      "rest": {
        "$value": "#8B6F47",
        "$description": "Concrete Creations primary accent — final (Adrian, 2026-09-26).",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "#8B6F47",
              "Dark": "#A8896A"
            }
          }
        }
      },
      "hover": {
        "$value": "#75593A",
        "$description": "Accent hover — slightly darker than rest. Final (Adrian, 2026-09-26).",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "#75593A",
              "Dark": "#BC9D7E"
            }
          }
        }
      },
      "pressed": {
        "$value": "#5C432A",
        "$description": "Accent pressed — deepest tone. Final (Adrian, 2026-09-26).",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "#5C432A",
              "Dark": "#D0B492"
            }
          }
        }
      },
      "subtle": {
        "$value": "#F5EFE7",
        "$description": "Accent tint — faint accent surface for hover halos. Final (Adrian, 2026-09-26).",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "#F5EFE7",
              "Dark": "#3A2E1F"
            }
          }
        }
      },
      "content": {
        "$value": "#75593A",
        "$description": "Accent text color — used for links and accent labels. Final (Adrian, 2026-09-26).",
        "$extensions": {
          "com.figma.variables": {
            "modes": {
              "Light": "#75593A",
              "Dark": "#BC9D7E"
            }
          }
        }
      }
    },
    "color": {
      "$type": "color",
      "surface": {
        "accent": {
          "$value": "#8B6F47",
          "$description": "Accent surface fill (CTAs, primary buttons). Final (Adrian, 2026-09-26).",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "#8B6F47",
                "Dark": "#8B6F47"
              }
            }
          }
        },
        "accentSubtle": {
          "$value": "#F5EFE7",
          "$description": "Faint accent tint surface. Final (Adrian, 2026-09-26).",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "#F5EFE7",
                "Dark": "#3A2E1F"
              }
            }
          }
        }
      },
      "border": {
        "accent": {
          "$value": "#8B6F47",
          "$description": "Accent border / focus ring. Final (Adrian, 2026-09-26).",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "#8B6F47",
                "Dark": "#A8896A"
              }
            }
          }
        }
      },
      "content": {
        "accent": {
          "$value": "#75593A",
          "$description": "Accent text colour — links and accent labels rendered as TEXT. Distinct from semantic.accent.content, which is the interactive-accent role. Both must be overridden: base HDS resolves this one to neutral-900, so leaving it out turns brand brown into near-black the first time anyone writes text-contentAccent. Final (Adrian, 2026-09-26).",
          "$extensions": {
            "com.figma.variables": {
              "modes": {
                "Light": "#75593A",
                "Dark": "#D0B492"
              }
            }
          }
        }
      }
    }
  }
}
